# uv run --frozen --env-file .env python manage.py runserver 127.0.0.1:8006 --noreload
# This file is a template. Keep the copied .env ignored and never commit secrets.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional locally; required for production (at least 50 random characters).
DJANGO_SECRET_KEY=
# Required for live market data requests; enter the real value securely.
INTRINIO_API_KEY=
# SQLite supports research/accounts only. Use PostgreSQL for private portfolios.
DJANGO_DATABASE_ENGINE=sqlite
# Development default is memory; production requires PostgreSQL shared limits.
DJANGO_RATE_LIMIT_BACKEND=memory
# Production-only opt-in after validating ingress header replacement/private access.
DJANGO_TRUST_PROXY_HTTPS=false
# Development stays public for local browser workflows. Production defaults differ.
DJANGO_PRIVATE_SITE=false
DJANGO_ALLOW_REGISTRATION=true
# For local Docker PostgreSQL use --env-file .local/database.env instead.
# For another PostgreSQL instance configure these explicitly and set engine above:
# DJANGO_DATABASE_NAME=
# DJANGO_DATABASE_USER=
# DJANGO_DATABASE_HOST=
# DJANGO_DATABASE_PORT=5432
# DJANGO_DATABASE_PASSWORD=
# DJANGO_DATABASE_SSLMODE=verify-full
# DJANGO_DATABASE_SSLROOTCERT=
