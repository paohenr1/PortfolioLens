# Template only. Supply values through the selected host's secure settings.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=
DJANGO_SECRET_KEY=
INTRINIO_API_KEY=
DJANGO_DATABASE_ENGINE=postgresql
DJANGO_DATABASE_NAME=
DJANGO_DATABASE_USER=
DJANGO_DATABASE_HOST=
DJANGO_DATABASE_PORT=5432
DJANGO_DATABASE_PASSWORD=
DJANGO_DATABASE_SSLMODE=verify-full
DJANGO_DATABASE_SSLROOTCERT=
DJANGO_RATE_LIMIT_BACKEND=postgresql
# Personal hosting defaults: sign-in required; create users through an operator.
DJANGO_PRIVATE_SITE=true
DJANGO_ALLOW_REGISTRATION=false
# Enable only after verifying ingress header replacement and blocked direct access.
DJANGO_TRUST_PROXY_HTTPS=false
PORT=8000
STOCK_WORKERS=1
# Managed web hosts may need 0.0.0.0; otherwise keep loopback behind local ingress.
STOCK_BIND_HOST=127.0.0.1
